# Copie este arquivo para .env.local e preencha os valores:
#   cp .env.example .env.local
# Nunca versione o arquivo com valores reais.

# --- NextAuth v5 (login com Google) ---
# Gere o segredo com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
# Credenciais OAuth criadas no Google Cloud Console
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Firebase Admin (Firestore e Storage) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Chave privada da conta de serviço, entre aspas, com \n nas quebras de linha
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUB_KEY=
# Segredo do webhook (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# IDs dos preços criados no painel do Stripe
STRIPE_SUBSCRIPTION_MONTH_PRICE_ID=
STRIPE_SUBSCRIPTION_YEAR_PRICE_ID=
STRIPE_PRICE_ONLY_ID=
